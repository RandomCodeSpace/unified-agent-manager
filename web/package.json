{
  "name": "uam-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test packages/ui/tests/*.test.mjs",
    "test:dom": "vitest run",
    "prebuild": "npm run lint && npm test",
    "build": "tsc --noEmit && vite build && node scripts/precompress.mjs ../internal/web/dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@uam/ui": "0.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "katex": "0.18.2",
    "dompurify": "3.4.17",
    "zod": "4.6.7",
    "lodash-es": "4.18.1",
    "nanoid": "3.3.19"
  },
  "workspaces": [
    "packages/ui"
  ]
}
